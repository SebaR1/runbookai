# Copiar a .env y completar. .env no se versiona.

# --- MongoDB ---
MONGO_ROOT_USER=runbook
MONGO_ROOT_PASSWORD=cambiar-esto
# Dentro de Compose: mongodb://runbook:<pass>@mongo:27017/?authSource=admin
# Desde el host:     mongodb://runbook:<pass>@localhost:27017/?authSource=admin

# --- Azurite (emulador de Azure Blob) ---
# Cuenta y clave son las públicas y fijas del emulador (no son secretos).
# Dentro de Compose usar el host "azurite"; desde el host, 127.0.0.1.
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;AccountKey=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==;BlobEndpoint=http://azurite:10000/devstoreaccount1;QueueEndpoint=http://azurite:10001/devstoreaccount1;

# --- Chroma ---
CHROMA_URL=http://chroma:8000

# --- Ollama (en el host Windows, API compatible con OpenAI) ---
OPENAI_BASE_URL=http://host.docker.internal:11434/v1
OPENAI_API_KEY=ollama
LLM_MODEL=qwen3:8b
# "none" apaga el thinking de Qwen3 por la API OpenAI (verificado: 0,2 s vs 16 s)
LLM_REASONING_EFFORT=none
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIMENSION=1024
