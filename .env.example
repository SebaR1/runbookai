# Copiar a .env y completar. .env no se versiona.
#
# Qué va acá: secretos y configuración que cambia entre máquinas o entornos.
# Qué NO va acá: las direcciones internas de Compose (chroma:8000, azurite:10000,
# host.docker.internal). Esas las fija docker-compose.yml en el "environment:"
# de cada servicio. VS Code carga este archivo en sus terminales
# (.vscode/settings.json), y una URL de Docker acá rompe la ejecución local.
# Las apps usan valores por defecto que apuntan a localhost.

# --- MongoDB ---
MONGO_ROOT_USER=runbook
MONGO_ROOT_PASSWORD=cambiar-esto

# --- Proveedor de LLM (Ollama hoy; OpenAI / Azure OpenAI después) ---
OPENAI_API_KEY=ollama
LLM_MODEL=qwen3:8b
# "none" apaga el thinking de Qwen3 por la API OpenAI (verificado: 0,2 s vs 16 s)
LLM_REASONING_EFFORT=none
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIMENSION=1024
